{
	"name": "empresaplana-website",
	"type": "module",
	"version": "0.3.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"nuxt:dev": "nuxt dev",
		"nuxt:build": "nuxt build",
		"nuxt:preview": "nuxt preview",
		"nuxt:prepare": "nuxt prepare",
		"cf:build": "NITRO_PRESET=cloudflare_pages nuxt build",
		"cf:dev": "NITRO_PRESET=cloudflare_pages nuxt build && wrangler pages dev dist --compatibility-flags=nodejs_compat",
		"render:build": "NITRO_PRESET=node_server nuxt build",
		"db:create-user": "tsx scripts/create-user.ts",
		"version:bump": "node scripts/bump-version.mjs",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"postinstall": "nuxt prepare || exit 0",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"db:setup": "pnpm run db:generate && pnpm run db:push && pnpm run db:seed",
		"seed:keystatic": "tsx scripts/seed-keystatic.ts"
	},
	"dependencies": {
		"@astrojs/markdoc": "^2.0.9",
		"@astrojs/react": "^6.0.5",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.6.9",
		"@nuxt/fonts": "^0.14.0",
		"@nuxt/ui": "^4.11.1",
		"@nuxtjs/i18n": "^10.6.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.2",
		"dotenv": "^17.4.2",
		"googleapis": "^178.1.1",
		"jose": "^6.2.12",
		"leaflet": "^1.9.4",
		"nuxt": "^4.5.2",
		"pg": "^8.23.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/node": "^11.1.5",
		"@biomejs/biome": "^2.5.13",
		"@js-temporal/polyfill": "^0.5.1",
		"@types/node": "^26.5.1",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"docx": "^9.7.1",
		"prisma": "^7.10.0",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"wrangler": "^4.131.1"
	},
	"author": "Sergio Jurado - @senseikatana",
	"description": "Website redesign of https://empresaplana.cat at Catalonia Transports Company"
}
