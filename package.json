{
	"name": "empresaplana-website",
	"type": "module",
	"version": "0.4.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"version:bump": "bun scripts/bump-version.mjs",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"postinstall": "prisma skills sync || exit 0",
		"db:generate": "bunx --bun prisma generate",
		"db:push": "bunx --bun prisma db push",
		"db:migrate": "bunx --bun prisma migrate dev",
		"db:seed": "bunx --bun prisma db seed",
		"db:studio": "bunx --bun prisma studio",
		"db:setup": "bun run db:generate && bun run db:push && bun run db:seed",
		"seed:keystatic": "bun run scripts/seed-keystatic.ts"
	},
	"prisma": {
		"seed": "bun run prisma/seed.ts"
	},
	"dependencies": {
		"@astrojs/markdoc": "^2.0.9",
		"@astrojs/react": "^6.0.5",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.6.9",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.2.10",
		"dotenv": "^17.4.2",
		"googleapis": "^178.0.0",
		"jose": "^6.2.10",
		"leaflet": "^1.9.4",
		"pg": "^8.23.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/node": "^11.1.5",
		"@biomejs/biome": "^2.5.11",
		"@js-temporal/polyfill": "^0.5.1",
		"@types/node": "^26.4.1",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"docx": "^9.7.1",
		"prisma": "^7.10.0",
		"typescript": "^6.0.3"
	},
	"author": "Sergio Jurado - @senseikatana",
	"description": "Website redesign of https://empresaplana.cat at Catalonia Transports Company"
}
