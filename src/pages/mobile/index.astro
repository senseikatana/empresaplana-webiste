---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSiteInfo, getCanonicalUrl } from "@/config/site-info";
export const prerender = true;
import { getLocale, getDictionary } from "@/config/i18n";

const locale = getLocale(Astro.url.searchParams.get("lang"));
const dict = getDictionary(locale);
const mob = dict.mobileApp;
const siteInfo = getSiteInfo({
	title: mob.title,
	description: dict.home.screens.mobile.desc,
	lang: locale,
	ogTitle: mob.hero.title,
	ogDescription: dict.home.screens.mobile.desc,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});
const bodyClass =
	"bg-background text-on-background font-body-md antialiased overflow-x-hidden min-h-screen flex flex-col max-w-[480px] mx-auto shadow-2xl relative";
---

<BaseLayout {...siteInfo} bodyClass={bodyClass} showHeader={false} showFooter={false}>
	<!-- Mobile App Header -->
	<div class="bg-surface-container-lowest px-margin-mobile py-stack-md flex justify-center items-center sticky top-0 z-40 border-b border-surface-variant">
		<span class="font-headline-md text-headline-md font-bold text-deep-navy flex items-center gap-2">
			<span class="material-symbols-outlined icon-filled" aria-hidden="true">directions_bus</span>
			{dict.common.brand}
		</span>
	</div>

	<!-- Main Content Canvas -->
	<main class="flex-grow pb-24">
		<!-- Hero Section with Search -->
		<section class="px-margin-mobile pt-stack-md pb-stack-lg relative">
			<div class="absolute inset-0 bg-gradient-to-b from-surface-container-lowest to-surface-container -z-10 h-3/4 rounded-b-3xl pointer-events-none"></div>
			<h1 class="font-headline-lg-mobile text-headline-lg-mobile text-deep-navy mb-stack-md px-2 text-center">{mob.hero.title}</h1>

			<!-- Booking Card -->
			<div class="bg-surface-container-lowest rounded-xl p-stack-md shadow-ambient border border-surface-variant relative overflow-hidden">
				<!-- Search Inputs -->
				<div class="flex flex-col gap-stack-sm relative z-10">
					<!-- Origin Input -->
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-coastal-teal">
							<span class="material-symbols-outlined icon-fill" aria-hidden="true">location_on</span>
						</div>
						<input class="w-full pl-10 pr-4 py-3 bg-surface-bright border border-surface-variant rounded-lg font-body-md text-on-surface focus:outline-none focus:border-coastal-teal focus:ring-1 focus:ring-coastal-teal transition-all" placeholder={mob.search.fromPlaceholder} type="text" />
					</div>
					<!-- Swap Button -->
					<div class="absolute right-4 top-[42px] z-20 flex justify-center items-center">
						<button class="bg-surface-container-lowest border border-surface-variant rounded-full p-2 shadow-sm text-deep-navy hover:text-coastal-teal transition-colors" aria-label="Intercambiar">
							<span class="material-symbols-outlined" aria-hidden="true">swap_vert</span>
						</button>
					</div>
					<!-- Destination Input -->
					<div class="relative mt-stack-sm">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-energetic-orange">
							<span class="material-symbols-outlined icon-fill" aria-hidden="true">flag</span>
						</div>
						<input class="w-full pl-10 pr-4 py-3 bg-surface-bright border border-surface-variant rounded-lg font-body-md text-on-surface focus:outline-none focus:border-coastal-teal focus:ring-1 focus:ring-coastal-teal transition-all" placeholder={mob.search.toPlaceholder} type="text" />
					</div>
					<!-- Date & Passenger Row -->
					<div class="flex gap-stack-sm mt-stack-sm">
						<div class="relative flex-1">
							<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-outline">
								<span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
							</div>
							<input class="w-full pl-10 pr-2 py-3 bg-surface-bright border border-surface-variant rounded-lg font-body-md text-on-surface focus:outline-none focus:border-coastal-teal focus:ring-1 focus:ring-coastal-teal transition-all" placeholder={mob.search.today} type="text" />
						</div>
						<div class="relative flex-1">
							<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-outline">
								<span class="material-symbols-outlined" aria-hidden="true">person</span>
							</div>
							<input class="w-full pl-10 pr-2 py-3 bg-surface-bright border border-surface-variant rounded-lg font-body-md text-on-surface focus:outline-none focus:border-coastal-teal focus:ring-1 focus:ring-coastal-teal transition-all" placeholder={mob.search.onePassenger} type="text" />
						</div>
					</div>
				</div>
				<!-- Primary Action -->
				<a
					class="w-full mt-stack-md bg-energetic-orange text-on-primary font-button text-button py-4 rounded-lg flex justify-center items-center gap-2 hover:opacity-90 transition-opacity shadow-md min-h-[48px]"
					href="/rutas-horarios"
				>
					<span class="material-symbols-outlined" aria-hidden="true">search</span>
					{mob.search.submit}
				</a>
			</div>
		</section>

		<!-- Quick Access Services (Bento Grid Style) -->
		<section class="px-margin-mobile py-stack-md">
			<h2 class="font-headline-md text-headline-md text-deep-navy mb-stack-md px-2">{mob.popular.title}</h2>
			<div class="grid grid-cols-2 gap-stack-md">
				<!-- Airport Transfers Card -->
				<div class="col-span-2 relative bg-surface-container-lowest rounded-xl overflow-hidden shadow-ambient border border-surface-variant group">
					<div
						class="bg-cover bg-center w-full h-32 relative"
						role="img"
						aria-label={mob.popular.airport.title}
						style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDhPy7mprqFfw1F2synvePredTy7sScMXIgwyM6NGsIoRdWij-RbKFrrqFlSn3wSPjbWd7mc8SrjYYr8_aTfUrTLLlFSFFrBg9-XUS0-cLSKxlItrWvTQo2VlNrp_LnTqd1L8cpdIGlGi_IuzaNj46QyOY4MC1BHRKkT4Y_fNV0vMR0_AoNMVU4wJeXkW31MRFzIdLYZJWqTpWRle-yUO6iVUIQ5aZwtgxquUYZrXMmjWDvoFYgy8wz')"
					>
						<div class="absolute inset-0 bg-gradient-to-t from-deep-navy/80 to-transparent pointer-events-none"></div>
					</div>
					<div class="absolute bottom-0 left-0 p-stack-md text-on-primary">
						<div class="font-label-md text-label-md uppercase tracking-wider mb-1 text-secondary-fixed">{mob.popular.airport.tag}</div>
						<h3 class="font-headline-md text-[20px] leading-tight font-bold">{mob.popular.airport.title}</h3>
					</div>
					<a class="absolute bottom-4 right-4 bg-surface-container-lowest/20 backdrop-blur-sm rounded-full p-2 text-on-primary group-hover:bg-surface-container-lowest group-hover:text-deep-navy transition-colors" href="/rutas-horarios" aria-label={mob.popular.airport.title}>
						<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
					</a>
				</div>
				<!-- Excursions Card -->
				<div class="col-span-1 bg-surface-container-lowest rounded-xl p-stack-md shadow-ambient border border-surface-variant flex flex-col items-start gap-stack-sm hover:border-coastal-teal transition-colors">
					<div class="bg-surface-container-low p-3 rounded-lg text-coastal-teal">
						<span class="material-symbols-outlined" aria-hidden="true">tour</span>
					</div>
					<div>
						<h3 class="font-label-md text-label-md text-deep-navy font-bold">{mob.popular.excursions.title}</h3>
						<p class="font-body-md text-[13px] text-on-surface-variant mt-1 leading-snug">{mob.popular.excursions.desc}</p>
					</div>
				</div>
				<!-- Timetables Card -->
				<div class="col-span-1 bg-surface-container-lowest rounded-xl p-stack-md shadow-ambient border border-surface-variant flex flex-col items-start gap-stack-sm hover:border-coastal-teal transition-colors">
					<div class="bg-surface-container-low p-3 rounded-lg text-primary-container">
						<span class="material-symbols-outlined" aria-hidden="true">schedule</span>
					</div>
					<div>
						<h3 class="font-label-md text-label-md text-deep-navy font-bold">{mob.popular.timetables.title}</h3>
						<p class="font-body-md text-[13px] text-on-surface-variant mt-1 leading-snug">{mob.popular.timetables.desc}</p>
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- Bottom Navigation Bar (Mobile Only) -->
	<nav class="fixed bottom-0 w-full max-w-[480px] bg-surface-container-lowest border-t border-surface-variant shadow-ambient px-4 py-3 flex justify-between items-center z-50">
		<a class="flex flex-col items-center gap-1 text-deep-navy w-16" href="/rutas-horarios">
			<span class="material-symbols-outlined icon-fill" aria-hidden="true">search</span>
			<span class="text-[10px] font-label-md font-bold">{mob.nav.search}</span>
		</a>
		<a class="flex flex-col items-center gap-1 text-on-surface-variant w-16 hover:text-coastal-teal transition-colors" href="/rutas-horarios">
			<span class="material-symbols-outlined" aria-hidden="true">confirmation_number</span>
			<span class="text-[10px] font-label-md">{mob.nav.tickets}</span>
		</a>
		<a class="flex flex-col items-center gap-1 text-on-surface-variant w-16 hover:text-coastal-teal transition-colors" href="/donde-estamos">
			<span class="material-symbols-outlined" aria-hidden="true">location_on</span>
			<span class="text-[10px] font-label-md">{mob.nav.stops}</span>
		</a>
		<a class="flex flex-col items-center gap-1 text-on-surface-variant w-16 hover:text-coastal-teal transition-colors" href="/solicitar-presupuesto">
			<span class="material-symbols-outlined" aria-hidden="true">account_circle</span>
			<span class="text-[10px] font-label-md">{mob.nav.profile}</span>
		</a>
	</nav>
</BaseLayout>
