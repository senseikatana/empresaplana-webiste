---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSiteInfo, getCanonicalUrl } from "@/config/site-info";
import { getLocale, getDictionary } from "@/config/i18n";

const locale = getLocale(Astro.url.searchParams.get("lang"));
const dict = getDictionary(locale);
const lc = dict.legal.legalNotice;

const siteInfo = getSiteInfo({
	title: lc.title,
	description: lc.heading,
	lang: locale,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});

const sectionKeys = Object.keys(lc.sections) as Array<keyof typeof lc.sections>;
const sidebarSections = [
	{ id: "info-general", label: dict.legal.legalNotice.sections.userConcept ? "1. Información General" : "" },
];
---

<BaseLayout {...siteInfo} bodyClass="bg-background text-on-surface font-body-md antialiased flex flex-col min-h-screen">
<main class="flex-grow flex flex-col items-center justify-start py-stack-lg px-margin-mobile md:px-margin-desktop w-full max-w-container-max mx-auto">
	<header class="w-full mb-stack-lg border-b border-outline-variant pb-stack-md">
		<h1 class="font-display-lg text-display-lg text-deep-navy mb-stack-sm">{lc.title}</h1>
		<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">{lc.heading}</p>
	</header>
	<div class="w-full flex flex-col md:flex-row gap-gutter md:gap-stack-lg">
		<!-- Sticky Sidebar Navigation -->
		<aside class="md:w-1/4 shrink-0">
			<nav class="sticky top-24 bg-surface-container-low rounded-xl p-stack-md">
				<ul class="space-y-stack-sm">
					{sectionKeys.map((key, i) => (
						<li>
							<a
								class="block font-label-md text-label-md text-on-surface hover:text-deep-navy transition-colors duration-200"
								href={`#${key}`}
							>
								{lc.sectionTitles[key]}
							</a>
						</li>
					))}
				</ul>
				<div class="mt-stack-md pt-stack-sm border-t border-outline-variant">
					<button
						class="font-label-md text-label-md text-energetic-orange flex items-center gap-2 hover:text-deep-navy transition-colors duration-200"
						onclick="window.dispatchEvent(new Event('open-cookie-settings'))"
					>
						<span class="material-symbols-outlined">cookie</span>
						Ajustes de Cookies
					</button>
				</div>
			</nav>
		</aside>
		<!-- Legal Content -->
		<div class="md:w-3/4 space-y-stack-lg pb-stack-lg">
			<section id="info-general" class="scroll-mt-24">
				<h2 class="font-headline-lg text-headline-lg text-deep-navy mb-stack-md">1. {lc.heading}</h2>
				<div class="bg-surface-container-lowest p-stack-md rounded-xl shadow-sm space-y-stack-md border border-outline-variant/30">
					<p class="font-body-md text-body-md text-on-surface">{lc.intro}</p>
					<p class="font-body-md text-body-md text-on-surface">{lc.address}</p>
				</div>
			</section>

			{sectionKeys.map((key, i) => (
				<section id={key} class="scroll-mt-24">
					<h2 class="font-headline-lg text-headline-lg text-deep-navy mb-stack-md">{lc.sectionTitles[key]}</h2>
					<p class="font-body-md text-body-md text-on-surface whitespace-pre-line leading-relaxed">{lc.sections[key]}</p>
				</section>
			))}
		</div>
	</div>
</main>
</BaseLayout>

<script>
	// Smooth scrolling for sidebar links
	document.querySelectorAll('aside nav a[href^="#"]').forEach((anchor) => {
		anchor.addEventListener('click', (e) => {
			e.preventDefault();
			const href = anchor.getAttribute('href');
			if (href) {
				document.querySelector(href)?.scrollIntoView({ behavior: 'smooth' });
			}
		});
	});
</script>
