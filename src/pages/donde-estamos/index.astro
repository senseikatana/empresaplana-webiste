---
import BaseLayout from "@/layouts/BaseLayout.astro";
import contact from "@/data/contact.json";
import { getSiteInfo, getCanonicalUrl } from "@/config/site-info";
import { getLocale, getDictionary } from "@/config/i18n";

const locale = getLocale(Astro.url.searchParams.get("lang"));
const dict = getDictionary(locale);
const loc = dict.locations;

const siteInfo = getSiteInfo({
	title: loc.title,
	description: loc.hero.subtitle,
	lang: locale,
	ogTitle: loc.hero.title,
	ogDescription: loc.hero.subtitle,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});
const bodyClass = "bg-background text-on-surface font-body-md antialiased";

const bases = Object.entries(loc.delegations.bases).map(([key, base], i) => ({
	key,
	...base,
	label: loc.delegations.label.replace("{n}", String(i + 1)),
}));
---

<BaseLayout {...siteInfo} bodyClass={bodyClass}>
<main class="w-full">
	<!-- Hero Section -->
	<section class="relative w-full h-[400px] md:h-[500px] bg-deep-navy flex items-center justify-center overflow-hidden">
		<div class="absolute inset-0 z-0">
			<img
				class="w-full h-full object-cover opacity-60 mix-blend-overlay"
				alt={loc.hero.title}
				src="https://lh3.googleusercontent.com/aida-public/AB6AXuAQ66k6zbgB5Vgn8Hx9fGVwFHtK3EOPeLBG2Ss3MLMIOqZaSkkFadbrCUmoWzFVF5o83CuRNEHXrqS3NUJQjcHy3QdWOVbj1fSikfRprsEb4qwNLyxBW1qKzr7mrtPF989QMCAfxB-xb3d762CNT62ilPy99M9Fq7zzJkJuIyQ4_cYQITtVDDtZBJsynafq9jZVorRKhyCv3MCl0xWd_qDcvJ7vFUUGH-FOgu1EBImHD87C5AVE_KVX"
			/>
		</div>
		<div class="relative z-10 text-center px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
			<h1 class="font-display-lg text-display-lg text-on-primary mb-stack-md">{loc.hero.title}</h1>
			<p class="font-body-lg text-body-lg text-on-primary/90 max-w-2xl mx-auto">{loc.hero.subtitle}</p>
		</div>
	</section>

	<!-- Map & Central Office Section -->
	<section class="relative max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop -mt-20 z-20 mb-stack-lg">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
			<div class="lg:col-span-8 bg-surface-container-lowest rounded-xl shadow-ambient overflow-hidden relative h-[400px] lg:h-auto min-h-[400px] border border-surface-variant">
				<img
					class="w-full h-full object-cover"
					alt="Red de oficinas Empresa Plana"
					src="https://lh3.googleusercontent.com/aida-public/AB6AXuCZHw_XR0BwP0YOlStJLT07Jp0AG0k95rXPHKX6xj5y2k6DpQQm7lZnNdJQNNCyfdPbE884aNXiIDDN-R0vAa3soUdwrcnQ8A3Fg7yo-mZQXceLw95zwH_EbIrM-41WkGrMHKuyR-mZKRIxHmEHzwmAaVeD5DXGMkFKcowjofQSMKi8Ohj5Y5jukSTt2rB3r4iGIBuiEPQJgMO5mouwQQAu5PBjcust9EW3xg5Ivk4vhHK2VyWO4eXD"
				/>
				<div class="absolute top-4 left-4 bg-surface-container-lowest/90 backdrop-blur-md px-4 py-2 rounded-full shadow-sm flex items-center gap-2">
					<span class="material-symbols-outlined text-energetic-orange text-sm">my_location</span>
					<span class="font-label-md text-label-md text-deep-navy">{loc.mapBadge}</span>
				</div>
			</div>
			<div class="lg:col-span-4 flex flex-col">
				<div class="bg-surface-container-lowest rounded-xl shadow-ambient p-8 flex-grow border border-surface-variant relative overflow-hidden group hover:border-coastal-teal/30 transition-colors duration-300">
					<div class="absolute top-0 right-0 w-32 h-32 bg-coastal-teal/5 rounded-bl-full -mr-8 -mt-8 transition-transform group-hover:scale-110 pointer-events-none"></div>
					<div class="relative z-10">
						<div class="w-12 h-12 bg-primary-fixed text-primary-container rounded-xl flex items-center justify-center mb-6">
							<span class="material-symbols-outlined" style="font-size: 28px;">business</span>
						</div>
						<h2 class="font-headline-md text-headline-md text-deep-navy mb-2">{loc.central.title}</h2>
						<h3 class="font-label-md text-label-md text-coastal-teal mb-6 uppercase tracking-wider">{loc.central.tag}</h3>
						<div class="space-y-4 font-body-md text-body-md text-on-surface-variant">
							<div class="flex items-start gap-3">
								<span class="material-symbols-outlined text-outline mt-1 text-xl">location_on</span>
								<div>
									<p>{loc.central.address1}<br />{loc.central.address2}</p>
									<p class="font-bold text-deep-navy mt-1">{loc.central.city}</p>
								</div>
							</div>
							<div class="flex items-center gap-3 pt-4 border-t border-surface-variant">
								<span class="material-symbols-outlined text-outline text-xl">phone</span>
								<a class="hover:text-coastal-teal transition-colors font-button text-button" href={`tel:${contact.generalPhone.replace(/\s/g, "")}`}>{contact.generalPhone}</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Delegations Grid -->
	<section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-stack-lg mb-24">
		<div class="flex items-center gap-4 mb-8">
			<h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-deep-navy">{loc.delegations.title}</h2>
			<div class="h-px bg-surface-variant flex-grow"></div>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
			{bases.map((base) => (
				<div class="bg-surface-container-lowest rounded-xl shadow-ambient p-6 border border-surface-variant hover:shadow-[0_8px_30px_rgba(1,57,144,0.12)] transition-shadow duration-300">
					<h3 class="font-headline-md text-headline-md text-deep-navy mb-1">{base.name}</h3>
					<p class="font-label-md text-label-md text-energetic-orange mb-4 uppercase">{base.label}</p>
					<div class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
						<span class="material-symbols-outlined text-outline/60 mt-0.5 text-lg">map</span>
						<div>
							<p>{base.address}</p>
							<p class="font-bold text-on-surface mt-1">{base.city}</p>
						</div>
					</div>
				</div>
			))}
		</div>
	</section>
</main>
</BaseLayout>
