---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSiteInfo, getCanonicalUrl } from "@/config/site-info";
import { getLocale, getDictionary } from "@/config/i18n";

const locale = getLocale(Astro.url.searchParams.get("lang"));
const dict = getDictionary(locale);
const siteInfo = getSiteInfo({
	title: "Solicitud confirmada - Empresa Plana",
	description: "Tu solicitud de presupuesto ha sido enviada correctamente.",
	lang: locale,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});
---

<BaseLayout {...siteInfo} bodyClass="bg-background text-on-surface min-h-screen flex flex-col">
	<main class="flex-grow flex items-center justify-center px-margin-mobile md:px-margin-desktop">
		<div class="max-w-2xl text-center py-stack-lg">
			<span class="material-symbols-outlined text-6xl text-coastal-teal mb-6">check_circle</span>
			<h1 class="font-headline-lg text-headline-lg font-bold text-deep-navy mb-4">Mensaje enviado correctamente</h1>
			<p class="font-body-lg text-body-lg text-on-surface-variant mb-8">Gracias por tu solicitud. Nos pondremos en contacto contigo a la brevedad.</p>
			<a href="/" class="inline-flex items-center justify-center bg-deep-navy text-on-primary font-button text-button px-8 py-3 rounded hover:opacity-90 transition-opacity min-h-[48px]">Volver al inicio</a>
		</div>
	</main>
</BaseLayout>
