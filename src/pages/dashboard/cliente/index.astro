---
import AppLayout from "@/layouts/AppLayout.astro";
import { getLocale, getDictionary } from "@/config/i18n";

const locale = getLocale(Astro.url.searchParams.get("lang"));
const dict = getDictionary(locale);
const a = dict.app;
const c = dict.common;

const ui = {
	greeting: a.client.greeting,
	nextService: a.client.nextService,
	noNextService: a.client.noNextService,
	quickAccess: a.client.quickAccess,
	myBudgets: a.client.myBudgets,
	newBudget: a.client.newBudget,
	noBudgets: a.client.noBudgets,
	noBudgetsDesc: a.client.noBudgetsDesc,
	trip: a.client.trip,
	sentOn: a.client.sentOn,
	roleLabel: a.status.label,
	role: a.role,
	nav: a.nav,
	locale,
	statusLabels: a.status,
};

const uiJson = JSON.stringify(ui);
---

<AppLayout title={c.brand} active="home" role="client">
	<!-- Greeting + next service (filled client-side) -->
	<section class="flex flex-col gap-stack-md">
		<div>
			<p id="client-greeting" class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-deep-navy"></p>
			<p id="client-role" class="font-label-md text-label-md uppercase tracking-widest text-coastal-teal mt-1"></p>
		</div>

		<div id="next-service" class="hidden bg-deep-navy text-on-primary rounded-xl p-stack-md md:p-6 flex flex-col md:flex-row md:items-center gap-4 relative overflow-hidden">
			<div class="absolute -right-10 -top-10 w-40 h-40 bg-surface-tint rounded-full blur-3xl opacity-40 pointer-events-none"></div>
		</div>

		<!-- Quick access -->
		<section>
			<h2 class="font-headline-md text-headline-md font-bold text-on-surface mb-stack-sm">{ui.quickAccess}</h2>
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-gutter">
				<a href="/dashboard/cliente/rutas" class="group bg-surface-container-lowest rounded-xl border border-surface-variant shadow-ambient p-5 flex flex-col gap-3 hover:shadow-ambient-lg hover:-translate-y-0.5 transition-all">
					<span class="w-11 h-11 rounded-full bg-coastal-teal/15 text-on-secondary-container flex items-center justify-center">
						<span class="material-symbols-outlined icon-filled">route</span>
					</span>
					<span class="font-headline-md text-headline-md font-bold text-deep-navy">{a.nav.routes}</span>
					<span class="font-body-md text-body-md text-on-surface-variant">{a.client.quickRoutes}</span>
					<span class="mt-auto pt-2 inline-flex items-center gap-1 font-label-md text-label-md text-coastal-teal group-hover:text-deep-navy transition-colors">
						{a.nav.routes}
						<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
					</span>
				</a>
				<a href="/dashboard/cliente/presupuestos" class="group bg-surface-container-lowest rounded-xl border border-surface-variant shadow-ambient p-5 flex flex-col gap-3 hover:shadow-ambient-lg hover:-translate-y-0.5 transition-all">
					<span class="w-11 h-11 rounded-full bg-energetic-orange/15 text-tertiary flex items-center justify-center">
						<span class="material-symbols-outlined icon-filled">request_quote</span>
					</span>
					<span class="font-headline-md text-headline-md font-bold text-deep-navy">{a.nav.budgets}</span>
					<span class="font-body-md text-body-md text-on-surface-variant">{a.client.quickBudgets}</span>
					<span class="mt-auto pt-2 inline-flex items-center gap-1 font-label-md text-label-md text-coastal-teal group-hover:text-deep-navy transition-colors">
						{a.nav.budgets}
						<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
					</span>
				</a>
				<a href="/dashboard/perfil" class="group bg-surface-container-lowest rounded-xl border border-surface-variant shadow-ambient p-5 flex flex-col gap-3 hover:shadow-ambient-lg hover:-translate-y-0.5 transition-all">
					<span class="w-11 h-11 rounded-full bg-primary-fixed text-on-primary-fixed flex items-center justify-center">
						<span class="material-symbols-outlined icon-filled">person</span>
					</span>
					<span class="font-headline-md text-headline-md font-bold text-deep-navy">{a.nav.profile}</span>
					<span class="font-body-md text-body-md text-on-surface-variant">{a.client.quickProfile}</span>
					<span class="mt-auto pt-2 inline-flex items-center gap-1 font-label-md text-label-md text-coastal-teal group-hover:text-deep-navy transition-colors">
						{a.nav.profile}
						<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
					</span>
				</a>
			</div>
		</section>

		<!-- Latest budgets -->
		<section>
			<div class="flex items-center justify-between mb-stack-sm">
				<h2 class="font-headline-md text-headline-md font-bold text-on-surface">{ui.myBudgets}</h2>
				<a href="/dashboard/cliente/presupuestos" class="inline-flex items-center gap-1 rounded-lg bg-deep-navy text-on-primary font-button text-button px-4 py-2.5 min-h-[44px] hover:opacity-90 transition-opacity">
					<span class="material-symbols-outlined text-[20px]">add</span>
					{ui.newBudget}
				</a>
			</div>
			<div id="latest-budgets" class="flex flex-col gap-2">
				<!-- rendered client-side -->
			</div>
		</section>
	</section>
</AppLayout>

<div id="app-ui" class="hidden" data-ui={uiJson}></div>
<script>
	import { getCurrentUser, listBudgets } from "@/lib/app-store";
	import { fmtDay, escapeHtml, statusMeta } from "@/lib/app-format";
	import { QUOTE_FORM } from "@/data";

	const ui = JSON.parse(document.getElementById("app-ui")?.dataset.ui ?? "{}");

	const reasonLabel = (id: string) =>
		QUOTE_FORM.reasons.find((r) => r.id === id)?.labels[ui.locale as "es" | "ca" | "en"] ?? id;

	const greeting = document.getElementById("client-greeting");
	const roleEl = document.getElementById("client-role");
	const nextService = document.getElementById("next-service");
	const latestBudgets = document.getElementById("latest-budgets");

	const user = getCurrentUser();
	if (user && greeting) greeting.textContent = ui.greeting.replace("{name}", user.name);
	if (user && roleEl) roleEl.textContent = ui.role[user.role as "client" | "worker" | "admin"];

	if (user) boot();

	function boot() {
	const budgets = listBudgets(user.id);
	const today = new Date().toISOString().slice(0, 10);

	// Next service: contracted/answered trip whose departure day is today or later.
	const active = budgets.filter(
		(b) => (b.status === "contracted" || b.status === "answered") && b.departureDay >= today,
	);
	const next = active.sort((x, y) => x.departureDay.localeCompare(y.departureDay))[0];

	if (next && nextService) {
		const meta = statusMeta(next.status, ui.statusLabels);
		nextService.classList.remove("hidden");
		nextService.innerHTML = `
			<span class="material-symbols-outlined text-coastal-teal text-[36px] flex-shrink-0">directions_bus</span>
			<div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-4 flex-1">
				<div>
					<p class="font-label-md text-label-md uppercase tracking-widest text-secondary-fixed">${escapeHtml(ui.nextService)}</p>
					<p class="font-headline-md text-headline-md font-bold mt-0.5">${escapeHtml(reasonLabel(next.reasonId))}</p>
				</div>
				<div class="flex items-center gap-2 font-body-md text-body-md text-on-primary/90">
					<span class="material-symbols-outlined text-[18px]">trip_origin</span>${escapeHtml(next.departureCity)}
					<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
					<span class="material-symbols-outlined text-[18px]">location_on</span>${escapeHtml(next.arrivalCity)}
				</div>
				<div class="font-label-md text-label-md text-secondary-fixed">
					${escapeHtml(fmtDay(next.departureDay, ui.locale))} · ${escapeHtml(next.departureTime)}
				</div>
			</div>
			<a href="/dashboard/cliente/presupuestos" class="shrink-0 inline-flex items-center gap-1.5 rounded-lg bg-energetic-orange text-on-primary font-button text-button px-4 py-2.5 hover:opacity-90 transition-opacity">
				${escapeHtml(ui.myBudgets)}
				<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
			</a>`;
	} else if (nextService) {
		nextService.classList.remove("hidden");
		nextService.classList.remove("bg-deep-navy", "text-on-primary");
		nextService.classList.add("bg-surface-gray", "text-on-surface", "border", "border-surface-variant");
		nextService.innerHTML = `
			<span class="material-symbols-outlined text-outline text-[32px]">event_available</span>
			<div class="flex-1 font-body-md text-body-md text-on-surface-variant">${escapeHtml(ui.noNextService)}</div>
			<a href="/dashboard/cliente/presupuestos" class="shrink-0 inline-flex items-center gap-1.5 rounded-lg bg-energetic-orange text-on-primary font-button text-button px-4 py-2.5 hover:opacity-90 transition-opacity">
				${escapeHtml(ui.newBudget)}
			</a>`;
	}

	// Latest 3 budgets with status chips.
	if (latestBudgets) {
		if (budgets.length === 0) {
			latestBudgets.innerHTML = `
				<div class="bg-surface-container-lowest rounded-xl border border-surface-variant p-8 text-center flex flex-col items-center gap-2">
					<span class="material-symbols-outlined text-[40px] text-outline">inbox</span>
					<p class="font-headline-md text-headline-md font-bold text-deep-navy">${escapeHtml(ui.noBudgets)}</p>
					<p class="font-body-md text-body-md text-on-surface-variant">${escapeHtml(ui.noBudgetsDesc)}</p>
					<a href="/dashboard/cliente/presupuestos" class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-deep-navy text-on-primary font-button text-button px-5 py-3 hover:opacity-90 transition-opacity">
						${escapeHtml(ui.newBudget)}
					</a>
				</div>`;
		} else {
			latestBudgets.innerHTML = budgets
				.slice(0, 3)
				.map((b) => {
					const meta = statusMeta(b.status, ui.statusLabels);
					return `
					<a href="/dashboard/cliente/presupuestos" class="bg-surface-container-lowest rounded-xl border border-surface-variant p-4 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 hover:border-deep-navy transition-colors">
						<div class="flex-1 min-w-0">
							<p class="font-headline-md text-headline-md font-bold text-deep-navy truncate">${escapeHtml(reasonLabel(b.reasonId))}</p>
							<p class="font-body-md text-body-md text-on-surface-variant flex items-center gap-1.5">
								<span class="material-symbols-outlined text-[16px]">${b.departureCity === b.arrivalCity ? "event" : "route"}</span>
								${b.departureCity !== b.arrivalCity ? `${escapeHtml(b.departureCity)} → ${escapeHtml(b.arrivalCity)}` : escapeHtml(b.departureCity)} · ${escapeHtml(fmtDay(b.departureDay, ui.locale))} ${escapeHtml(b.departureTime)}
							</p>
						</div>
						<span class="${meta.chipClass}">${meta.icon ? `<span class="material-symbols-outlined text-[16px]">${meta.icon}</span>` : ""}${escapeHtml(meta.label)}</span>
					</a>`;
				})
				.join("");
		}
	}
	}
</script>
