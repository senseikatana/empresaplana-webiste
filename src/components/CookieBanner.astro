---
import { getLocale, getDictionary } from "@/config/i18n";

const locale = getLocale(Astro.url.searchParams.get("lang"));
const b = getDictionary(locale).legal.cookieBanner;
---

<!-- Consent banner (shown by script when no stored consent) -->
<div
	id="cookie-banner"
	class="hidden fixed inset-x-0 bottom-0 z-50 px-margin-mobile md:px-margin-desktop pb-margin-mobile"
	role="dialog"
	aria-live="polite"
	aria-label={b.privacyTitle}
>
	<div class="max-w-container-max mx-auto glass-panel rounded-xl shadow-ambient-lg p-stack-md md:p-stack-lg flex flex-col md:flex-row items-start md:items-center gap-stack-md">
		<p class="flex-1 font-body-md text-body-md text-on-surface">{b.intro}</p>
		<div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
			<button
				id="cookie-accept"
				class="bg-deep-navy text-on-primary font-button text-button px-6 py-3 rounded min-h-[48px] hover:opacity-90 transition-opacity"
			>
				{b.accept}
			</button>
			<button
				id="cookie-deny"
				class="border border-outline-variant bg-surface-container-lowest text-on-surface font-button text-button px-6 py-3 rounded min-h-[48px] hover:border-deep-navy hover:text-deep-navy transition-colors"
			>
				{b.deny}
			</button>
			<button
				id="cookie-settings-button"
				class="border border-outline-variant bg-surface-container-lowest text-on-surface font-button text-button px-6 py-3 rounded min-h-[48px] hover:border-deep-navy hover:text-deep-navy transition-colors"
			>
				{b.settings}
			</button>
		</div>
	</div>
</div>

<!-- Settings modal -->
<div
	id="cookie-modal"
	class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-inverse-surface/50 backdrop-blur-sm px-margin-mobile"
	role="dialog"
	aria-modal="true"
	aria-label={b.privacyTitle}
>
	<div class="bg-surface-container-lowest w-full max-w-2xl rounded-xl shadow-ambient-lg flex flex-col max-h-[90vh]">
		<div class="p-stack-md border-b border-surface-variant flex justify-between items-center gap-4">
			<h3 class="font-headline-md text-headline-md text-deep-navy">{b.privacyTitle}</h3>
			<button id="cookie-close-modal" class="text-on-surface-variant hover:text-on-surface" aria-label={b.settings}>
				<span class="material-symbols-outlined">close</span>
			</button>
		</div>
		<div class="p-stack-md overflow-y-auto font-body-md text-body-md text-on-surface space-y-stack-md">
			<p class="text-on-surface-variant">{b.privacyDesc}</p>

			<div class="flex items-start justify-between gap-4 bg-surface-container rounded-lg p-stack-md">
				<div>
					<p class="font-label-md text-label-md text-on-surface">{b.technicalTitle}</p>
					<p class="text-on-surface-variant mt-1">{b.technicalDesc}</p>
					<ul class="mt-stack-sm space-y-1 text-on-surface-variant text-sm">
						<li>{b.sessionCookie}</li>
						<li>{b.xsrfCookie}</li>
					</ul>
				</div>
				<input checked disabled class="mt-1 h-5 w-5 rounded border-outline-variant text-deep-navy focus:ring-deep-navy cursor-not-allowed" type="checkbox" aria-label={b.technicalTitle} />
			</div>

			<div class="flex items-start justify-between gap-4 bg-surface-container rounded-lg p-stack-md">
				<div>
					<p class="font-label-md text-label-md text-on-surface">{b.analyticsTitle}</p>
					<p class="text-on-surface-variant mt-1">{b.analyticsDesc}</p>
					<ul class="mt-stack-sm space-y-1 text-on-surface-variant text-sm">
						<li>{b.googleAnalytics}</li>
					</ul>
				</div>
				<input id="cookie-analytics" class="mt-1 h-5 w-5 rounded border-outline-variant text-deep-navy focus:ring-deep-navy" type="checkbox" />
			</div>

			<p class="text-sm text-outline">{b.lastReview}</p>
		</div>
		<div class="p-stack-md border-t border-surface-variant bg-surface-container-low rounded-b-xl flex flex-wrap justify-end gap-2">
			<button
				id="cookie-reject-all"
				class="border border-outline-variant bg-surface-container-lowest text-on-surface font-button text-button px-5 py-3 rounded min-h-[48px] hover:border-deep-navy hover:text-deep-navy transition-colors"
			>
				{b.rejectAll}
			</button>
			<button
				id="cookie-accept-all"
				class="bg-deep-navy text-on-primary font-button text-button px-5 py-3 rounded min-h-[48px] hover:opacity-90 transition-opacity"
			>
				{b.acceptAll}
			</button>
			<button
				id="cookie-save"
				class="bg-energetic-orange text-on-primary font-button text-button px-5 py-3 rounded min-h-[48px] hover:opacity-90 transition-opacity"
			>
				{b.save}
			</button>
		</div>
	</div>
</div>

<script>
	const CONSENT_KEY = "plana-cookie-consent";

	const banner = document.getElementById("cookie-banner");
	const modal = document.getElementById("cookie-modal");
	const analyticsInput = document.getElementById("cookie-analytics") as HTMLInputElement | null;

	function storeConsent(analytics: boolean) {
		try {
			localStorage.setItem(
				CONSENT_KEY,
				JSON.stringify({ necessary: true, analytics, date: new Date().toISOString() }),
			);
		} catch {
			/* storage unavailable (private mode): consent is not persisted */
		}
		banner?.classList.add("hidden");
		modal?.classList.add("hidden");
	}

	function openModal() {
		try {
			const raw = localStorage.getItem(CONSENT_KEY);
			if (raw && analyticsInput) {
				analyticsInput.checked = Boolean(JSON.parse(raw).analytics);
			}
		} catch {
			/* ignore malformed stored consent */
		}
		modal?.classList.remove("hidden");
	}

	try {
		if (!localStorage.getItem(CONSENT_KEY)) {
			banner?.classList.remove("hidden");
		}
	} catch {
		/* storage unavailable: show the banner so the choice can still be made */
		banner?.classList.remove("hidden");
	}

	document.getElementById("cookie-accept")?.addEventListener("click", () => storeConsent(true));
	document.getElementById("cookie-deny")?.addEventListener("click", () => storeConsent(false));
	document.getElementById("cookie-accept-all")?.addEventListener("click", () => storeConsent(true));
	document.getElementById("cookie-reject-all")?.addEventListener("click", () => storeConsent(false));
	document.getElementById("cookie-save")?.addEventListener("click", () => storeConsent(Boolean(analyticsInput?.checked)));

	document.getElementById("cookie-settings-button")?.addEventListener("click", openModal);
	document.getElementById("cookie-close-modal")?.addEventListener("click", () => modal?.classList.add("hidden"));

	// Other pages (e.g. aviso-legal) can open the settings modal with:
	// window.dispatchEvent(new Event("open-cookie-settings"))
	window.addEventListener("open-cookie-settings", openModal);
</script>
