---
type Tone = "default" | "teal" | "orange" | "navy";

interface Props {
	icon: string;
	label: string;
	value: string;
	hint?: string;
	tone?: Tone;
	/** When set, the value element gets data-kpi so scripts can fill it. */
	kpiKey?: string;
}

const { icon, label, value, hint, tone = "navy", kpiKey } = Astro.props;

const iconTones: Record<Tone, string> = {
	default: "bg-surface-container text-on-surface-variant",
	teal: "bg-coastal-teal/15 text-on-secondary-container",
	orange: "bg-energetic-orange/15 text-tertiary",
	navy: "bg-primary-fixed text-on-primary-fixed",
};

const valueTones: Record<Tone, string> = {
	default: "text-on-surface",
	teal: "text-on-secondary-container",
	orange: "text-on-surface",
	navy: "text-deep-navy",
};
---

<div class="bg-surface-container-lowest rounded-xl border border-surface-variant p-5 flex flex-col gap-3">
	<div class="flex items-center gap-3">
		<span class={`w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 ${iconTones[tone]}`}>
			<span class="material-symbols-outlined icon-filled text-[22px]">{icon}</span>
		</span>
		<span class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant">{label}</span>
	</div>
	<div class="flex flex-col">
		<span class={`font-headline-lg text-headline-lg font-bold ${valueTones[tone]}`} data-kpi={kpiKey}>{value}</span>
		{hint && <span class="font-body-md text-body-md text-on-surface-variant mt-1">{hint}</span>}
	</div>
</div>
